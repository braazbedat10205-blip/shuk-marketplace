# Copy to a secret-managed location outside source control. Never commit real values.
NODE_ENV=production
DATABASE_URL=postgresql://STAGING_USER:STAGING_PASSWORD@STAGING_DB_HOST:5432/shuk_staging
JWT_SECRET=GENERATE_A_UNIQUE_RANDOM_VALUE_WITH_AT_LEAST_32_CHARACTERS
PORT=4000

# Public HTTPS origins. Build the web app with these values.
WEB_ORIGIN=https://staging.example.com
APP_URL=https://staging.example.com
NEXT_PUBLIC_SITE_URL=https://staging.example.com
NEXT_PUBLIC_API_URL=https://api.staging.example.com/api

# Must be a persistent mounted directory in staging.
UPLOAD_ROOT=/var/lib/shuk/uploads

# Optional until staging SMTP credentials are provided.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
