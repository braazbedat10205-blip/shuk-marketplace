# Required in all environments
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
NEXT_PUBLIC_API_URL=http://localhost:4000/api
WEB_ORIGIN=http://localhost:3000
PORT=4000
# Required in production; used in password-reset links
APP_URL=http://localhost:3000

# Optional. Use durable storage outside the app container in production.
UPLOAD_ROOT=./uploads

# Optional SMTP configuration. Password reset email delivery is disabled when omitted.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
